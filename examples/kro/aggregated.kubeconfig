apiVersion: v1
kind: Config
clusters:
  - name: aggregated
    cluster:
      server: https://127.0.0.1:8443
      insecure-skip-tls-verify: true
contexts:
  - name: aggregated
    context:
      cluster: aggregated
      user: anonymous
users:
  - name: anonymous
    user:
      # TODO(ntnn): api-aggregator currently has no authn setup, so this is a bogus value
      token: unused
current-context: aggregated
